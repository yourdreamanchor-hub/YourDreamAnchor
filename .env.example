# ── Required ────────────────────────────────────────────────
# Postgres connection string.
#   Local:      postgres://localhost:5432/yda
#   Production: Supabase → Connect → Transaction pooler (port 6543), with your DB password filled in
DATABASE_URL=postgres://localhost:5432/yda
# Long random string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Media storage: Supabase Storage via its S3 API (optional locally) ──
# Leave empty to store uploads in ./media on this machine.
# Supabase → Storage → S3 Configuration shows the endpoint and region, and creates the access keys.
S3_ENDPOINT=https://wlglptqvibteedhouosc.supabase.co/storage/v1/s3
# Your Supabase project region
S3_REGION=ap-northeast-1
S3_BUCKET=yourdreamanchor
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL of the bucket (no trailing slash)
S3_PUBLIC_URL=https://wlglptqvibteedhouosc.supabase.co/storage/v1/object/public/yourdreamanchor

# ── Enquiry email alerts: Resend (optional) ─────────────────
# Without a key, emails are printed to the server console.
RESEND_API_KEY=
# Sender address on a domain verified in Resend (onboarding@resend.dev works for testing)
EMAIL_FROM=
# Where alerts go. Falls back to the email in Admin → Site settings.
NOTIFY_EMAIL=
